# =============================================================================
# Global Environment Configuration
# Copy this file to .env and fill in your values.
#
# This single file is used by:
#   - docker/compose.yml  (infrastructure services)
#   - api/                (Python backend)
#   - svelte/             (Vite dev server)
# =============================================================================


# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------
API_MODE=development          # development | production
API_ADDRESS=0.0.0.0
API_PORT=7879
API_DOMAIN=http://localhost:7879

API_WORKERS=4
API_THREADS=4
API_BLOCKING_THREADS=2


# -----------------------------------------------------------------------------
# CORS  (comma-separated lists; * = allow all)
# -----------------------------------------------------------------------------
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*


# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
AUTH_MODE=magic               # magic | credentials
AUTH_MASTER=admin@example.com

# JWT — generate secret with: python3 -c "import secrets; print(secrets.token_hex(64))"
AUTH_JWT_SECRET=changeme
AUTH_JWT_EXPIRES_IN=30        # minutes
AUTH_JWT_REFRESH_EXPIRES_IN=7 # days

AUTH_MIN_PASSWORD_LENGTH=14

# Comma-separated list of allowed email domains for magic-link sign-up
# (only enforced when API_MODE=production)
AUTH_MAGIC_ALLOWED_DOMAINS=example.com


# -----------------------------------------------------------------------------
# SMTP
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_DOMAIN=example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=changeme


# -----------------------------------------------------------------------------
# PostgreSQL  (used by both Docker Compose and the API)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=equipqr
POSTGRES_PASSWORD=changeme
POSTGRES_DATABASE=aviator_pg
DB_ENGINE=tortoise.backends.asyncpg

# Optional: path to a legacy CSV to import once on startup
DB_IMPORTER_LEGACY_PATH=


# -----------------------------------------------------------------------------
# MinIO / Object Storage
# Docker Compose uses MINIO_ROOT_USER/PASSWORD; the API uses MINIO_ACCESS_KEY/SECRET_KEY.
# Set them to the same values.
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_ADDRESS=localhost
MINIO_ACCESS_KEY=minioadmin    # same as MINIO_ROOT_USER
MINIO_SECRET_KEY=changeme      # same as MINIO_ROOT_PASSWORD
MINIO_SECURE=false


# -----------------------------------------------------------------------------
# Redis / KeyDB
# Docker Compose uses KEYDB_PASSWORD/PORT; the API uses REDIS_*.
# Set them to the same values.
# -----------------------------------------------------------------------------
KEYDB_PASSWORD=changeme
KEYDB_PORT=6379

REDIS_ADDRESS=localhost
REDIS_PORT=6379                # same as KEYDB_PORT
REDIS_PASSWORD=changeme        # same as KEYDB_PASSWORD
REDIS_SECURE=false


# -----------------------------------------------------------------------------
# Svelte / Vite dev server  (svelte/.env)
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=5173
PROXY_TARGET=http://127.0.0.1:7879

# Optional HTTPS for the dev server — leave commented out for plain HTTP
# SSL_CERT_FILE=../private/certificates/localhost+2.pem
# SSL_KEY_FILE=../private/certificates/localhost+2-key.pem
